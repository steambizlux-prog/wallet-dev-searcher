# ---- Telegram ----
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Куда слать находки по умолчанию: ваш личный id (узнать: @userinfobot). Канал проще задать потом
# из бота командой /channel (или перешлите боту пост из канала)
TELEGRAM_CHAT_ID=123456789
# Кто может управлять ботом (через запятую, личные id). Если пусто — TELEGRAM_CHAT_ID
TELEGRAM_ADMIN_IDS=

# ---- GMGN OpenAPI ----
# Ключ создаётся на https://gmgn.ai/ai (нужен Ed25519 публичный ключ, см. README)
GMGN_API_KEY=gmgn_xxxxxxxxxxxxxxxxxxxx
# Адрес API (менять не нужно)
GMGN_API_HOST=https://openapi.gmgn.ai

# ---- Прочее ----
# Папка для settings.json и базы sqlite
DATA_DIR=./data
LOG_LEVEL=INFO
